{
  "compilerOptions": {
    "module": "esnext",
    "esModuleInterop": true,
    "target": "es2017",
    "lib": ["es2017", "dom", "webworker"],
    "moduleResolution": "node",
    "outDir": "dist",
    "sourceMap": true,
    "strict": false,
    "removeComments": true
  },
  "experiments": {
    "topLevelAwait": true
  },
  "include": [
    "App.ts",
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
